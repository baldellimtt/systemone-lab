# Copy to .env and adjust. Never commit .env.

# --- Default: local Laya (scripts/start_laya.ps1) ---
TYPESAFE_BASE_URL=http://127.0.0.1:8000
TYPESAFE_API_KEY=local
# Leave unset so Laya's router can pick english vs multilingual from the text.
# TYPESAFE_DEFAULT_MODEL=english
NO_PROXY=localhost,127.0.0.1

# --- Option A: hosted TypeSafe Jev ---
# TYPESAFE_API_KEY=sk-...
# TYPESAFE_DEFAULT_MODEL=jev-latest
# (remove TYPESAFE_BASE_URL)

# --- Option B: vllm-jev ---
# TYPESAFE_BASE_URL=http://127.0.0.1:8795
# TYPESAFE_API_KEY=local
# TYPESAFE_DEFAULT_MODEL=ZefanCai/Open-Jev-2B

# --- Option C: OpenJev on Codiv ---
# TYPESAFE_BASE_URL=https://api.codiv.ai
# TYPESAFE_API_KEY=sk-codiv-...
# TYPESAFE_DEFAULT_MODEL=openjev-latest
